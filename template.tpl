___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const sendPixel = require("sendPixel");
const logToConsole = require("logToConsole");
const encodeUriComponent = require("encodeUriComponent");

const params = [];

data.fieldtable.forEach(function(row) {
  params.push(
    encodeUriComponent(row.field) +
    "=" +
    encodeUriComponent(row.value)
  );
});

const webhookUrl = data.webhook + "?" + params.join("&");

logToConsole("webhookUrl: " + webhookUrl);

sendPixel(
  webhookUrl,
  data.gtmOnSuccess,
  data.gtmOnFailure
);


